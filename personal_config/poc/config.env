# Local PoC on this Mac. Secrets are optional for Ollama (no cloud API key).
# Switch the sandbox agent here. The shared LLM runs in Docker Compose
# (compose/docker-compose.yml), not a host Homebrew Ollama process.

OS=macos

# hermes | openclaw | langchain-deepagents-code
NEMOCLAW_AGENT=hermes

# Shared LLM (Compose Ollama). All sandboxes on this machine reuse this daemon.
# qwen2.5:3b is a true 3B model but native context is 32k, so Hermes onboard
# rejects it (needs ≥ 64000). qwen3:4b is the closest Qwen that qualifies.
# For exact 3B, set NEMOCLAW_AGENT=openclaw and NEMOCLAW_MODEL=qwen2.5:3b.
NEMOCLAW_PROVIDER=ollama
NEMOCLAW_MODEL=qwen3:4b
NEMOCLAW_YES=1

NEMOCLAW_SANDBOX_NAME=poc-claw
NEMOCLAW_POLICY_TIER=balanced
NEMOCLAW_WEB_SEARCH_PROVIDER=none

# Discord (token stays in personal_config/poc/secrets.env as DISCORD_BOT_TOKEN)
DISCORD_SERVER_ID=1560913859047587860
DISCORD_REQUIRE_MENTION=1
# This Mac's Docker VM reports ~7.7 GiB; official check wants 8 GiB.
NEMOCLAW_IGNORE_RUNTIME_RESOURCES=1
