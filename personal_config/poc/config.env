# PoC for a Mac mini M4 with 16 GB unified memory.
# macOS uses host Ollama (Metal) and Homebrew openshell-gateway.
# The compose gateway and compose Ollama stay stopped.
# Secrets stay in personal_config/poc/secrets.env.

OS=macos

# hermes | openclaw | langchain-deepagents-code
NEMOCLAW_AGENT=hermes

# Hermes still requires loaded context >= 64000.
# qwen3:4b is the 16 GB default. qwen3.5:9b at 64k with q4_0 KV was about
# 7.2 GiB and contends with the Docker VM for the same unified memory.
# qwen3:8b Q4 is not the default until its Ollama context is >= 64000 and
# its RSS is measured. Do not keep two models resident.
# qwen2.5:3b is 32k, so Hermes rejects it. Exact 3B means
# NEMOCLAW_AGENT=openclaw and NEMOCLAW_MODEL=qwen2.5:3b.
NEMOCLAW_PROVIDER=ollama
NEMOCLAW_MODEL=qwen3:4b
NEMOCLAW_YES=1

NEMOCLAW_SANDBOX_NAME=poc-claw
NEMOCLAW_POLICY_TIER=balanced
NEMOCLAW_WEB_SEARCH_PROVIDER=none

# Discord (token stays in personal_config/poc/secrets.env as DISCORD_BOT_TOKEN)
DISCORD_SERVER_ID=1560913859047587860
DISCORD_REQUIRE_MENTION=1
# This Mac's Docker VM reports ~7.7 GiB; official check wants 8 GiB.
NEMOCLAW_IGNORE_RUNTIME_RESOURCES=1
