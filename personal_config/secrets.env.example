# Per-user secrets. Copy next to that user's config.env:
#   cp personal_config/secrets.env.example personal_config/<user>/secrets.env
#   chmod 600 personal_config/<user>/secrets.env
#
# Fill only the variables required by that user's config.env.
# Do not commit the filled file. Do not put these values in GitHub Secrets.

# Local Ollama (NEMOCLAW_PROVIDER=ollama) needs no key; skip this file.

# Inference (pick the one that matches NEMOCLAW_PROVIDER)
# NVIDIA_INFERENCE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# COMPATIBLE_API_KEY=
# COMPATIBLE_ANTHROPIC_API_KEY=

# Optional web search (when NEMOCLAW_WEB_SEARCH_PROVIDER is tavily or brave)
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# Optional messaging
# TELEGRAM_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# Discord (required when DISCORD_SERVER_ID is set in that user's config.env)
# DISCORD_BOT_TOKEN=

# Optional gated model pulls
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
